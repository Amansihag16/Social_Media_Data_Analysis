# ==============================================================================
# SocialPulse Platform Configuration Template
# Copy this file to .env and provide your credentials.
# Never commit the actual .env file with secrets into version control.
# ==============================================================================

# Environment Setting: development, staging, production
ENVIRONMENT=development

# ------------------------------------------------------------------------------
# Source 1: Reddit API Credentials
# Obtain at: https://www.reddit.com/prefs/apps
# ------------------------------------------------------------------------------
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here
REDDIT_USER_AGENT=SocialPulseAnalytics/1.0.0 by YourUsername
REDDIT_SUBREDDITS=technology,datascience,MachineLearning,gadgets,apple
REDDIT_POST_LIMIT=100

# ------------------------------------------------------------------------------
# Source 2: YouTube Data API v3 Credentials
# Obtain at: https://console.cloud.google.com/apis/credentials
# ------------------------------------------------------------------------------
YOUTUBE_API_KEY=your_youtube_api_key_here
YOUTUBE_SEARCH_QUERIES=AI technology,data engineering,smartphones,cloud computing
YOUTUBE_MAX_RESULTS=50

# ------------------------------------------------------------------------------
# Source 3: Bluesky (AT Protocol)
# Public XRPC API requires no auth for search, or use your App Password
# ------------------------------------------------------------------------------
BLUESKY_HANDLE=your_handle.bsky.social
BLUESKY_APP_PASSWORD=your_app_password_here
BLUESKY_SEARCH_QUERIES=technology,datascience,python,databricks
BLUESKY_POST_LIMIT=100

# ------------------------------------------------------------------------------
# Storage and Delta Lake Paths (Local or Databricks DBFS)
# ------------------------------------------------------------------------------
DATA_RAW_DIR=./data/raw
DATA_PROCESSED_DIR=./data/processed
DATA_SAMPLE_DIR=./data/sample
DELTA_BRONZE_DIR=./data/delta/bronze
DELTA_SILVER_DIR=./data/delta/silver
DELTA_GOLD_DIR=./data/delta/gold

# ------------------------------------------------------------------------------
# Databricks Workspace (Optional for remote execution)
# ------------------------------------------------------------------------------
DATABRICKS_HOST=https://community.cloud.databricks.com
DATABRICKS_TOKEN=your_databricks_personal_access_token
DATABRICKS_CLUSTER_ID=your_cluster_id
