{
  "name": "SocialPulse Modern Theme",
  "dataColors": [
    "#10B981",
    "#EF4444",
    "#6B7280",
    "#3B82F6",
    "#8B5CF6",
    "#F59E0B",
    "#06B6D4",
    "#EC4899"
  ],
  "background": "#F9FAFB",
  "foreground": "#111827",
  "tableAccent": "#3B82F6",
  "visualStyles": {
    "*": {
      "*": {
        "outspacePane": [
          {
            "backgroundColor": { "solid": { "color": "#FFFFFF" } },
            "foregroundColor": { "solid": { "color": "#111827" } }
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": { "solid": { "color": "#111827" } },
            "fontSize": 12,
            "fontFamily": "Segoe UI Semibold"
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "fontSize": 24,
            "fontFamily": "Segoe UI Bold",
            "color": { "solid": { "color": "#1E3A8A" } }
          }
        ],
        "categoryLabels": [
          {
            "fontSize": 10,
            "fontFamily": "Segoe UI",
            "color": { "solid": { "color": "#6B7280" } }
          }
        ]
      }
    }
  }
}
